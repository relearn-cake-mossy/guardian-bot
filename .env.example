# Discord Developer Portal > Bot
DISCORD_TOKEN=

# SQLite file path; use a persistent disk/volume on your hosting provider.
DATABASE_PATH=data/guardian.sqlite

# Optional path to a custom welcome-card background image (PNG/JPG/WebP)
WELCOME_BACKGROUND_PATH=assets/welcome-background.png
WELCOME_TEXT={user} đã tham gia {server}!
GOODBYE_TEXT={user} đã rời {server}.

# Moderation settings
SPAM_MESSAGE_LIMIT=5
SPAM_WINDOW_SECONDS=8
DUPLICATE_MESSAGE_LIMIT=3
MASS_MENTION_LIMIT=5
BLOCKED_WORDS=
BLOCKED_DOMAINS=

# AI moderation is optional; local moderation works without an API key.
# Add keys comma-separated for automatic failover; AI_API_KEY remains supported for one key.
AI_API_KEYS=
AI_MODEL=qwen3.8-27b
# Must be a vision-capable model to inspect images.
AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# At most one AI request per minute globally.
AI_REQUEST_INTERVAL_SECONDS=60
AI_MAX_CALLS_PER_HOUR=60
AI_USER_COOLDOWN_SECONDS=30
AI_MIN_CONFIDENCE=0.9
# Randomly sample 20% of eligible messages; sampled requests are batched.
AI_SAMPLE_RATE=0.2
AI_BATCH_SIZE=5
AI_BATCH_INTERVAL_MS=3000
AI_MAX_PENDING=500
